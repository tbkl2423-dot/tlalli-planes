  "explicacion": [
    {
      "texto": "Factorizar es lo contrario de multiplicar: escribir una expresión como producto."
    },
    {
      "texto": "Factor común: 6x + 9 = 3(2x + 3)."
    },
    {
      "texto": "Trinomio: x² + 5x + 6 = (x + 2)(x + 3), porque 2 + 3 = 5 y 2 × 3 = 6."
    }
  ],
  "ejercicios": [
