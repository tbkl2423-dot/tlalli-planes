  "explicacion": [
    {
      "texto": "Los adverbios de frecuencia dicen qué tan seguido pasa algo: always, usually, often, sometimes, rarely y never."
    },
    {
      "texto": "Van antes del verbo principal: I usually walk to work."
    },
    {
      "texto": "Pero van después del verbo to be: she is always late."
    }
  ],
