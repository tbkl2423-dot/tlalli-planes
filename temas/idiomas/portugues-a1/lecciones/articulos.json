  "explicacion": [
    {
      "texto": "Los artículos son o, a, os, as: el, la, los, las."
    },
    {
      "texto": "Se combinan con preposiciones: de más o da do, en más a da na."
    },
    {
      "texto": "Por ejemplo: a casa do João, la casa de João; estou na escola, estoy en la escuela."
    }
  ],
