  "explicacion": [
    {
      "texto": "Los pronombres personales son I, you, he, she, it, we y they."
    },
    {
      "texto": "Los posesivos indican de quién es algo: my, your, his, her, its, our y their."
    },
    {
      "texto": "Ejemplo: this is my book significa este es mi libro."
    }
  ],
