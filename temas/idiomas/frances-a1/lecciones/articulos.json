  "titulo": "Artículos y género",
  "version": 1,
  "duracion_min": 5,
  "explicacion": [
    {
      "texto": "Todos los sustantivos tienen género. Le es masculino y la femenino: le livre, el libro; la table, la mesa."
    },
    {
      "texto": "Antes de vocal se usa l': l'école. El plural es les."
    },
    {
      "texto": "Los indefinidos son un, une y des."
    }
  ],
