  "explicacion": [
    {
      "texto": "Être es ser o estar: je suis, tu es, il est, nous sommes, vous êtes, ils sont."
    },
    {
      "texto": "Avoir es tener: j'ai, tu as, il a, nous avons, vous avez, ils ont."
    },
    {
      "texto": "Para la edad se usa avoir: j'ai vingt ans, tengo veinte años."
    }
