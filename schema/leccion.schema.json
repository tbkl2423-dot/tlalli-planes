{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/tbkl2423-dot/tlalli-planes/schema/leccion.schema.json",
  "title": "Lección de Tlalli",
  "description": "La explicación se narra por voz; cada ejercicio indica con 'tipo' qué pantalla mostrar (micrófono, editor de código o campo de texto).",
  "type": "object",
  "required": ["id", "tema", "subtema", "titulo", "version", "duracion_min", "explicacion", "ejercicios"],
  "additionalProperties": false,
  "properties": {
    "id": { "$ref": "#/$defs/id" },
    "tema": { "$ref": "#/$defs/id" },
    "subtema": { "$ref": "#/$defs/id" },
    "titulo": { "type": "string", "minLength": 2, "maxLength": 80 },
    "version": { "type": "integer", "minimum": 1 },
    "duracion_min": { "type": "integer", "minimum": 1, "maximum": 15 },
    "explicacion": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "description": "Bloques cortos que la mascota narra por voz (20-30 s cada uno).",
      "items": {
        "type": "object",
        "required": ["texto"],
        "additionalProperties": false,
        "properties": {
          "texto": { "type": "string", "minLength": 5, "maxLength": 600 },
          "codigo": { "type": "string", "maxLength": 1500, "description": "Código opcional que se muestra en pantalla mientras se narra." }
        }
      }
    },
    "ejercicios": {
      "type": "array",
      "minItems": 1,
      "maxItems": 15,
      "items": { "$ref": "#/$defs/ejercicio" }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$", "maxLength": 60 },
    "base": {
      "type": "object",
      "required": ["id", "tipo", "explicacion_respuesta"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "tipo": { "type": "string" },
        "pista": { "type": "string", "maxLength": 300 },
        "explicacion_respuesta": { "type": "string", "minLength": 5, "maxLength": 600, "description": "Por qué la respuesta es correcta. Se narra al terminar." }
      }
    },
    "ejercicio": {
      "oneOf": [
        {
          "description": "Pregunta de concepto por voz; el usuario responde hablando y la IA evalúa por significado.",
          "allOf": [{ "$ref": "#/$defs/base" }],
          "required": ["pregunta", "respuesta_esperada"],
          "properties": {
            "tipo": { "const": "voz_pregunta" },
            "pregunta": { "type": "string", "maxLength": 300 },
            "respuesta_esperada": { "type": "string", "maxLength": 300 },
            "palabras_clave": { "type": "array", "items": { "type": "string" }, "description": "Para evaluar sin IA cuando no hay clave configurada." },
            "id": true, "pista": true, "explicacion_respuesta": true
          },
          "additionalProperties": false
        },
        {
          "description": "Opción múltiple; se puede contestar por voz ('la B') o tocando.",
          "allOf": [{ "$ref": "#/$defs/base" }],
          "required": ["pregunta", "opciones", "correcta"],
          "properties": {
            "tipo": { "const": "opcion_multiple" },
            "pregunta": { "type": "string", "maxLength": 300 },
            "opciones": { "type": "array", "minItems": 2, "maxItems": 5, "items": { "type": "string", "maxLength": 200 } },
            "correcta": { "type": "integer", "minimum": 0, "maximum": 4 },
            "id": true, "pista": true, "explicacion_respuesta": true
          },
          "additionalProperties": false
        },
        {
          "description": "Práctica de código: el usuario escribe. Para JS se ejecutan las pruebas localmente.",
          "allOf": [{ "$ref": "#/$defs/base" }],
          "required": ["lenguaje", "instruccion", "codigo_inicial", "pruebas"],
          "properties": {
            "tipo": { "const": "codigo" },
            "lenguaje": { "type": "string", "enum": ["javascript", "python", "java", "kotlin", "html", "css", "sql", "otro"] },
            "instruccion": { "type": "string", "maxLength": 400 },
            "codigo_inicial": { "type": "string", "maxLength": 1500 },
            "funcion": { "type": "string", "description": "Nombre de la función a probar." },
            "pruebas": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "required": ["entrada", "salida"],
                "additionalProperties": false,
                "properties": { "entrada": { "type": "array" }, "salida": {} }
              }
            },
            "solucion": { "type": "string", "maxLength": 1500 },
            "id": true, "pista": true, "explicacion_respuesta": true
          },
          "additionalProperties": false
        },
        {
          "description": "Completar un hueco (___) en código o en una oración. Se escribe.",
          "allOf": [{ "$ref": "#/$defs/base" }],
          "required": ["enunciado", "respuestas_validas"],
          "properties": {
            "tipo": { "const": "completar" },
            "enunciado": { "type": "string", "maxLength": 600, "pattern": "___" },
            "respuestas_validas": { "type": "array", "minItems": 1, "items": { "type": "string" } },
            "id": true, "pista": true, "explicacion_respuesta": true
          },
          "additionalProperties": false
        },
        {
          "description": "Idiomas: traducir escribiendo.",
          "allOf": [{ "$ref": "#/$defs/base" }],
          "required": ["frase", "idioma_origen", "idioma_destino", "respuestas_validas"],
          "properties": {
            "tipo": { "const": "traduccion" },
            "frase": { "type": "string", "maxLength": 300 },
            "idioma_origen": { "type": "string" },
            "idioma_destino": { "type": "string" },
            "respuestas_validas": { "type": "array", "minItems": 1, "items": { "type": "string" } },
            "id": true, "pista": true, "explicacion_respuesta": true
          },
          "additionalProperties": false
        },
        {
          "description": "Idiomas: la mascota dice una frase y el usuario la escribe.",
          "allOf": [{ "$ref": "#/$defs/base" }],
          "required": ["frase", "idioma"],
          "properties": {
            "tipo": { "const": "escucha" },
            "frase": { "type": "string", "maxLength": 300 },
            "idioma": { "type": "string" },
            "id": true, "pista": true, "explicacion_respuesta": true
          },
          "additionalProperties": false
        },
        {
          "description": "Idiomas: el usuario repite la frase en voz alta y se compara con el reconocimiento de voz.",
          "allOf": [{ "$ref": "#/$defs/base" }],
          "required": ["frase", "idioma"],
          "properties": {
            "tipo": { "const": "pronunciacion" },
            "frase": { "type": "string", "maxLength": 300 },
            "idioma": { "type": "string" },
            "umbral_similitud": { "type": "number", "minimum": 0, "maximum": 1, "default": 0.8 },
            "id": true, "pista": true, "explicacion_respuesta": true
          },
          "additionalProperties": false
        }
      ]
    }
  }
}
